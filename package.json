{
  "name": "keystone-pm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096 ${NODE_OPTIONS:-}\" next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=4096 ${NODE_OPTIONS:-}\" tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:reset": "rm -rf .data",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/run.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "backup": "tsx --conditions=react-server scripts/backup.ts",
    "restore": "tsx --conditions=react-server scripts/restore.ts",
    "app": "bash desktop/build-app.sh",
    "remaining:page": "tsx scripts/remaining-work/build.ts",
    "load:seed": "tsx --conditions=react-server scripts/load/seed-volume.ts",
    "load:measure": "tsx --conditions=react-server scripts/load/measure.ts",
    "load:check": "tsx --conditions=react-server scripts/load/measure.ts --budget --runs=3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@phosphor-icons/react": "^2.1.10",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
