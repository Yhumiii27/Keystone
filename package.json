{
  "name": "keystone-pm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:reset": "rm -rf .data",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/run.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "app": "bash desktop/build-app.sh",
    "remaining:page": "tsx scripts/remaining-work/build.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@phosphor-icons/react": "^2.1.10",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "jose": "6.2.12",
    "next": "16.4.0",
    "openid-client": "6.8.8",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
