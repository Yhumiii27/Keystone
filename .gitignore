# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# secrets: env files, keys, certificates, credentials, passwords
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.gpg
*.asc
id_rsa*
id_ed25519*
*.ppk
.npmrc
.netrc
credentials*
*credentials*.json
secrets*
*.secret
*.secrets
passwords*
*.password
.htpasswd
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database (PGlite)
/.data

# design source archives (extracted in design/)
/*.zip

# Mac app build output (npm run app)
/desktop/dist
/.next-ci/
/dist/

# extracted copy of the design archive (same content as design/)
/Keystone PM project management mockup/

# local test servers / temp data
/tmp/
*.log

# Generated pages to publish (npm run remaining:page)
.artifacts/
