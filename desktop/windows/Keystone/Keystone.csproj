<!-- Keystone.exe, the Windows application of Keystone PM (R-210). Built by desktop/windows/build.ps1:
     dotnet publish -c Release -r win-x64 → one self-contained Keystone.exe (no .NET to install; WebView2 runtime needed). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 (LTS, supported until Nov 2028): .NET 8 support ends on 10 Nov 2026. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build (and be checked) on Linux or macOS too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Keystone</AssemblyName>
    <RootNamespace>Keystone.Desktop</RootNamespace>
    <ApplicationIcon>Keystone.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <!-- Overridden by build.ps1 with the version of package.json. -->
    <Version>0.1.0</Version>
    <Product>Keystone</Product>
    <Company>EPC2i</Company>
    <Copyright>Système EPC2i — Gestion de projets</Copyright>
    <Description>Keystone — gestion de projets</Description>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!-- dotnet publish -r win-x64: a single self-contained Keystone.exe. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Keystone.ico" LogicalName="Keystone.ico" />
  </ItemGroup>

  <!-- The WebView2 package also references its WPF control, which pulls a second WindowsBase into a Windows Forms app
       (warning MSB3277): only the Windows Forms control is used. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
